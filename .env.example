# Runtime mode ---------------------------------------------------------------
# Local/demo: APP_MODE=demo, mocks and demo seeding may be enabled.
# Production: APP_MODE=production, PostgreSQL/PostGIS and Mapbox are required,
# and both mock routing and demo seeding must be disabled.
APP_MODE=demo
ENVIRONMENT=development
API_PREFIX=/api/v1

# Database -------------------------------------------------------------------
# Direct local Python development can use: sqlite:///./riskroute.db
# Compose uses the PostGIS URL below. Use a managed, TLS-enforced DSN in prod.
POSTGRES_DB=riskroute
POSTGRES_USER=riskroute
POSTGRES_PASSWORD=riskroute-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://riskroute:riskroute-local-only@db:5432/riskroute
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Routing and API policy ------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
ALLOW_MOCK_MAPBOX=true
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAPBOX_TIMEOUT_SECONDS=10
MAPBOX_MAX_RETRIES=2
MAPBOX_CIRCUIT_FAILURE_THRESHOLD=5
MAPBOX_CIRCUIT_RESET_SECONDS=30
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=1048576
DATASET_MAX_AGE_DAYS=550
REPORT_RETENTION_DAYS=30

# Dallas / North Dallas launch boundary -------------------------------------
LAUNCH_AREA_NAME="Dallas / North Dallas, Texas"
LAUNCH_MIN_LAT=32.60
LAUNCH_MAX_LAT=33.15
LAUNCH_MIN_LNG=-97.05
LAUNCH_MAX_LNG=-96.40

# Frontend (NEXT_PUBLIC_* values are embedded at image build time) -----------
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Production checklist (set these values in the deployment secret manager):
# APP_MODE=production
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://... (managed PostGIS, TLS required)
# MAPBOX_ACCESS_TOKEN=<server-side token>
# ALLOW_MOCK_MAPBOX=false
# SEED_DEMO_DATA=false
# CORS_ORIGINS=https://riskroute.example
